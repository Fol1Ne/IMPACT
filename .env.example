# Copy to .env and fill in. Never commit .env.
PORT=3001
# Origin the browser uses. Dev: http://localhost:5173 (Vite). Production (npm start): http://localhost:3001
CLIENT_URL=http://localhost:5173

# Event sources. Neither needs a key.
# USGS FDSN event service is built in. NASA EONET v3 base URL (override only for testing):
NASA_EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
# News: Google News RSS search, no key required.

# Armed conflict countries come from Wikipedia's "List of ongoing armed conflicts" (no key).
# Optional ACLED / UCDP credentials are unused by the current Conflict tab (kept for event-level work).
ACLED_EMAIL=
ACLED_PASSWORD=
UCDP_ACCESS_TOKEN=

# Twilio (server-side only). Required for pin SMS alerts. Test credentials are fine.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OpenRouter (server-side only) https://openrouter.ai/keys
# Used by earthquake briefings and the safety planner. Without it both fall back to source data only.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models that you have access to
OPENROUTER_MODEL=openai/gpt-4o
# Comma-separated models tried in order when the primary returns 402 (no credits), 404, 429 or 5xx, or an empty reply.
# ":free" models work on accounts without credits but are rate-limited and slower.
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_TIMEOUT_MS=30000

# Stripe TEST mode only. Live keys are refused. Never mix test and live keys.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...). Sent to the browser for the Payment Element; it is not a secret.
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (whsec_...). Required for donation status; optional for the preparedness purchase.
STRIPE_WEBHOOK_SECRET=
# Test connected accounts standing in for the four charities in the Donate popup. Optional: without them,
# test payments stay on the platform's test balance. Create with `npm run stripe:create-charities -w server`
# (first review "responsibilities of managing losses" under Connect > Platform profile in the Dashboard).
STRIPE_CHARITY_IFRC=
STRIPE_CHARITY_MSF=
STRIPE_CHARITY_UNICEF=
STRIPE_CHARITY_WFP=
# Legacy single-charity Payment Element flow (not used by the Donate popup). Create one with:
#   npm run stripe:create-charity -w server
STRIPE_CONNECTED_ACCOUNT_ID=

# Optional donation settings
DONATION_CHARITY_NAME=IMPACT Test Relief Fund (Stripe test account)
DONATION_CURRENCY=eur
DONATION_MIN_CENTS=100
DONATION_MAX_CENTS=50000

# Optional preparedness product overrides
PRODUCT_PRICE_CENTS=500
PRODUCT_CURRENCY=eur
