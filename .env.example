# Copy to .env and fill in. Never commit .env.
PORT=3001
# Origin the browser uses. Dev: http://localhost:5173 (Vite). Production (npm start): http://localhost:3001
CLIENT_URL=http://localhost:5173

# OpenRouter (server-side only) https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models that you have access to
OPENROUTER_MODEL=openai/gpt-4o-mini

# Stripe TEST mode only (keys beginning sk_test_). Live keys are refused.
STRIPE_SECRET_KEY=
# From `stripe listen` (whsec_...). Optional: checkout still works without it via the verify endpoint.
STRIPE_WEBHOOK_SECRET=

# Optional product overrides
PRODUCT_PRICE_CENTS=500
PRODUCT_CURRENCY=eur
